{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "test-results-dashboard-web",
    "compatibility_date": "2025-03-25",
    "compatibility_flags": [
        "nodejs_compat",
        "global_fetch_strictly_public"
    ],
    "workers_dev": false,
    "main": ".open-next/worker.js",
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    "services": [
        {
            "binding": "SELF",
            "service": "test-results-dashboard-web",
        },
        {
            "binding": "API",
            "service": "test-results-dashboard-api-dashboard",
        },
    ],
    // "r2_buckets": [
    //     {
    //       "binding": "NEXT_INC_CACHE_R2_BUCKET",
    //       "bucket_name": "<BUCKET_NAME>",
    //     },
    // ],
    "observability": {
        "enabled": true
    },
    "images": {
        "binding": "IMAGES"
    }
}
