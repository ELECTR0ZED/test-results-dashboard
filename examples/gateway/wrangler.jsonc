/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "test-results-dashboard-gateway",
	"main": "src/index.ts",
	"compatibility_date": "2025-11-04",
	"observability": {
		"enabled": true
	},
	"compatibility_flags": ["nodejs_compat"],
	"placement": { "mode": "smart" },
	"services": [
		{
			"binding": "WEB",
			"service": "test-results-dashboard-web"
		},
		{
			"binding": "API_INGEST",
			"service": "test-results-dashboard-api-ingest"
		},
		{
			"binding": "API_DASHBOARD",
			"service": "test-results-dashboard-api-dashboard"
		}
	]
}